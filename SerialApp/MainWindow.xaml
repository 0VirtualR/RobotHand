<Window x:Class="SerialApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SerialApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="38,51,422,187">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="AUTO" />
                <ColumnDefinition Width="17*"/>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="56*"/>
            </Grid.ColumnDefinitions>
            <Label Content="串口号：" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="1" Height="32" Width="90" Grid.ColumnSpan="2" Margin="5,12"/>
            <ComboBox Height="24" Width="120"  x:Name="ComboBoxSerial" VerticalAlignment="Center" Grid.Column="3" Margin="52,16">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="Black"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="波特率：" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Height="32" Width="90" Grid.ColumnSpan="2" Margin="5,12"/>
            <ComboBox Width="120" Height="24" x:Name="ComboBoxRate" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="3" Margin="52,16">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="Black"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button HorizontalAlignment="Center" Content="连接" FontSize="20" Width="100" Background="#0077C0" Foreground="White" BorderBrush="#003C60" BorderThickness="0" Margin="66,15,63,9"  Grid.Row="2" Grid.Column="3" Click="ConnectPort_Click" x:Name="Connection"/>
            <Ellipse Width="30" Height="30" Fill="Red" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1" x:Name="PortLight" Margin="35,13,3.266,13"/>
        </Grid>
        <TextBlock Text="运行日志：" FontSize="22"  Margin="24,247,476,144"/>
        <ListBox x:Name="LogBox"   Margin="10,289,460,15"/>
        <Button Content="X轴向前" HorizontalAlignment="Left" Margin="499,35,0,0" VerticalAlignment="Top" Width="163" Height="39" Click="X_Up_Click"/>
        <Button Content="X轴向后" HorizontalAlignment="Left" Margin="499,97,0,0" VerticalAlignment="Top" Width="163" Height="39" Click="X_Down_Click"/>
        <Button Content="Y轴向前" HorizontalAlignment="Left" Margin="499,159,0,0" VerticalAlignment="Top" Width="163" Height="39" Click="Y_Up_Click"/>
        <Button Content="Y轴向后" HorizontalAlignment="Left" Margin="499,221,0,0" VerticalAlignment="Top" Width="163" Height="39" Click="Y_Down_Click"/>
        <Button Content="Z轴向上" HorizontalAlignment="Left" Margin="499,279,0,0" VerticalAlignment="Top" Width="163" Height="39" Click="Z_Up_Click"/>
        <Button Content="Z轴向下" HorizontalAlignment="Left" Margin="499,341,0,0" VerticalAlignment="Top" Width="163" Height="39" Click="Z_Down_Click"/>

    </Grid>
</Window>
