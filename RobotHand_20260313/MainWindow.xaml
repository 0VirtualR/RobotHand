<Window x:Class="RobotHand_20260313.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobotHand_20260313"
        mc:Ignorable="d"
        Title="机械臂注胶上位机程序"
        Height="600"
        Width="1000"
         Style="{StaticResource MaterialDesignWindow}"
        Loaded="MainWindow_Load" Closing="MainWindow_Closing">
    <Window.Resources>

    </Window.Resources>
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>
        <StackPanel Background="#F0F0F0" Orientation="Horizontal" >
            <Button Margin="30,0" Content="开始程序" Name="Btn_Start" Click="Btn_Start_Click"/>
            <Button Content="初始化程序" x:Name="Btn_Init" Click="Btn_Init_Click"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="650"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Canvas x:Name="OverlayCanvas" Margin="15,5" IsHitTestVisible="False" />
                <Image x:Name="ImageView" Margin="15,5" Stretch="Uniform" />
            </Grid>
            <StackPanel Grid.Column="1">
                <TextBlock Text="串口操作：" FontSize="22"  Margin="25,10"/>
                <Grid Margin="20"  Height="134" Width="308">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="AUTO" />
                        <ColumnDefinition Width="95*"/>
                        <ColumnDefinition Width="213*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="串口号：" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"  Grid.Column="1" Height="32" Width="90"/>
                    <ComboBox Height="25" Width="120"  x:Name="ComboBoxSerial" VerticalAlignment="Center" Grid.Column="2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label Content="波特率：" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Height="33" Width="90"/>
                    <ComboBox Width="120" Height="25" x:Name="ComboBoxRate" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="Black"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button HorizontalAlignment="Center" Content="连接" FontSize="20" Width="100" Background="#0077C0" Foreground="White" BorderBrush="#003C60" BorderThickness="0" Margin="0,3,0,-1"  Grid.Row="2" Grid.Column="2" Click="ConnectPort_Click" x:Name="Connection"/>
                    <Ellipse Width="30" Height="30" Fill="Red" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1" x:Name="PortLight"/>
                </Grid>
                <TextBlock Text="运行日志：" FontSize="22"  Margin="25,10"/>
                <ListBox Name="LogBox"   Height="124"   Margin="10"/>
                <TextBox TextWrapping="Wrap" x:Name="MinRegion" Text="30" Width="120"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Name="TimeText"
            FontSize="14"/>
    </Grid>
</Window>
